# ==============================================================================
# APEXSOVEREIGN.AI - HARDENED PRODUCTION ENVIRONMENT MATRIX
# TARGET ENVIRONMENT: Vercel serverless (api/*.ts) + Supabase PostgreSQL
# NOTICE: Strict failure mode. Services abort startup when mandatory keys are
# missing or when PayPal is configured for live settlement without the explicit
# founder override. Values below are names and placeholders only.
# File Permissions: chmod 0600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & TOPOLOGY MATRIX
# ------------------------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production
CLUSTER_REGION=us-east-virginia-01
PRIMARY_DOMAIN=apexsovereign.ai

# Frontend build-time API origin. Leave empty when the API is served from the
# same origin as the Vite build (the Vercel default).
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Port Assignments (legacy locally-hosted services only; not used by Vercel)
PORT_AETHELMESH=8080
PORT_AETHELPAY=3000
PORT_AURAPHARM=8001
PORT_GOVERNANCE=8000

# ------------------------------------------------------------------------------
# 2. SUPABASE ATOMIC LEDGER CONNECTIONS (STRICT ACID / PESSIMISTIC LOCKING)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection pool string (Port 5432 or PgBouncer Port 6543)
DATABASE_URL=postgresql://postgres:<STRONG_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Supabase REST endpoint and server-only service role key.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ------------------------------------------------------------------------------
# 3. PAYPAL REST API v2 (SANDBOX DEFAULT / LIVE REQUIRES FOUNDER OVERRIDE)
# ------------------------------------------------------------------------------
# PAYPAL_ENV must be "sandbox" unless the founder has completed a documented
# live-settlement review. Live mode aborts startup unless
# FOUNDER_PAYPAL_LIVE_OVERRIDE carries the founder confirmation token.
PAYPAL_ENV=sandbox
FOUNDER_PAYPAL_LIVE_OVERRIDE=
PAYPAL_CLIENT_ID=<PAYPAL_CLIENT_ID>
PAYPAL_CLIENT_SECRET=<PAYPAL_CLIENT_SECRET>
PAYPAL_WEBHOOK_ID=<PAYPAL_WEBHOOK_ID>
# Legacy HMAC webhook field; unused by the REST signature verification path.
PAYPAL_WEBHOOK_SECRET=<PAYPAL_WEBHOOK_SECRET>

# Internal Automated Workflow Verification Secret (n8n Ingress/Egress)
N8N_HMAC_SECRET=<N8N_HMAC_SECRET>

# Internal Ledger Transaction Hash Key (Agentic Concurrency Protection)
APEX_SETTLEMENT_HMAC_SECRET=<APEX_SETTLEMENT_HMAC_SECRET>

# ------------------------------------------------------------------------------
# 4. AURAPHARM ED25519 ASYMMETRIC KEY PAIR (MOLECULAR IP MINTING)
# ------------------------------------------------------------------------------
# Base64-encoded PKCS#8 PEM private key for minting ED25519-EdDSA tokens.
# Generate with: openssl genpkey -algorithm ED25519 -outform PEM | base64 -w 0
AURAPHARM_ED25519_PRIVATE_KEY_B64=<BASE64_PKCS8_ED25519_PRIVATE_KEY>

# Base64-encoded SubjectPublicKeyInfo PEM public key for verification.
AURAPHARM_ED25519_PUBLIC_KEY_B64=<BASE64_SPKI_ED25519_PUBLIC_KEY>

# Basal Load Arbitrage Clearing Price Threshold ($/GPU-hr)
GPU_PRICE_THRESHOLD=1.85
SPOT_RESERVE_FLOOR_USD=1.85
MARGINAL_ENERGY_COST_USD=0.55

# ------------------------------------------------------------------------------
# 5. ATOMIC IN-MEMORY EVENT STREAM & IDEMPOTENCY BUFFER (REDIS)
# ------------------------------------------------------------------------------
# Redis (self-hosted event stream)
REDIS_HOST=apexsovereign-redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_URL=redis://:<REDIS_PASSWORD>@apexsovereign-redis:6379/0

# Upstash REST rate limiting for Vercel serverless functions
UPSTASH_REDIS_REST_URL=https://<UPSTASH_ENDPOINT>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REST_TOKEN>
RATE_LIMIT_IP_SALT=<RANDOM_64_HEX>

# ------------------------------------------------------------------------------
# 6. WHOLESALE GRID MONITORING ENDPOINTS & THERMAL CEILINGS
# ------------------------------------------------------------------------------
ERCOT_GRID_TELEMETRY_URL=https://api.gridstatus.io/v1/ercot/lmp/spot
NORDPOOL_GRID_TELEMETRY_URL=https://api.nordpoolgroup.com/v1/marketdata/dayahead
GRID_LMP_MAX_THRESHOLD_USD_MWH=180.00
MIN_THERMAL_HEADROOM_CELSIUS=10.0

# ------------------------------------------------------------------------------
# 7. CI/CD & MULTI-CLOUD DEPLOYMENT DISPATCH
# ------------------------------------------------------------------------------
# Render deploy hook retained for rollback tooling only; Render API routes are
# decommissioned and must not receive production traffic.
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/<DEPLOY_ID>?key=<DEPLOY_KEY>

# Edge Server SSH Automation Targets
PROD_SSH_HOST=edge-gateway.apexsovereign.ai
PROD_SSH_USER=deploy
# PROD_SSH_KEY stored strictly in GitHub Secrets
