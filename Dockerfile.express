# syntax=docker/dockerfile:1.4
# ==============================================================================
# APEXSOVEREIGN.AI — AETHELPAY EXPRESS SETTLEMENT GATEWAY DOCKERFILE
# Multi-Stage Node.js 20 Alpine Production Build
# Hardened Non-Root Security (UID 1000 node)
# ==============================================================================

# Stage 1: Dependency Resolver
FROM node:20-alpine AS dependencies

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY services/aethelpay/package.json ./
RUN npm ci --omit=dev --ignore-scripts || npm install --omit=dev --no-audit --no-fund

# Stage 2: Production Minimal Runtime
FROM node:20-alpine AS runtime

LABEL maintainer="ApexSovereign Holdings DevOps <infra@apexsovereign.ai>"
LABEL service="aethelpay-express"

WORKDIR /app

# Install security patches & curl/wget
RUN apk update && apk upgrade && apk add --no-cache dumb-init curl tzdata \
    && rm -rf /var/cache/apk/*

ENV NODE_ENV=production \
    PORT=3000

# Copy node_modules from dependencies stage
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node services/aethelpay/ ./

# Enforce least privilege non-root user
USER node

EXPOSE 3000

# Express gateway healthcheck
HEALTHCHECK --interval=15s --timeout=4s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
