# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- ApexSovereign.ai Enterprise Backend: The 6 Mandatory Variables ---
# 1. Supabase PostgreSQL Async Connection String
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Master Administrative & Routing Key (X-API-Key header)
APP_SECRET_API_KEY="sk_live_apex_sovereign_enterprise_secret_token_12345"

# 3. HMAC Secret for Signing Autonomous Compute Execution Leases
LEASE_HMAC_SECRET="sec_hmac_sha256_compute_lease_signature_key_98765"

# 4. PayPal REST App Client ID
PAYPAL_CLIENT_ID="AZ_your_paypal_client_id_here"

# 5. PayPal REST App Secret Key
PAYPAL_CLIENT_SECRET="EL_your_paypal_client_secret_here"

# 6. PayPal Webhook ID for Signature Verification
PAYPAL_WEBHOOK_ID="WH-91827364501928374"

# 7. Resend API Key for Transactional Email Autopilot & Receipts
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="ApexSovereign Concierge <concierge@apexsovereign.ai>"
EMAIL_REPLY_TO="support@apexsovereign.ai"

# 8. SMS Authentication Gateway (Twilio or Enterprise SMS Provider)
TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550199"

# 9. Administrative IP Access Token for Codebase Clearance (Client-side Optional)
VITE_ADMIN_ACCESS_TOKEN="apex-sec-admin-2026"
VITE_ADMIN_ACCESS_T="apex-sec-admin-2026"

# 10. ApexMind Sovereign Neural Mesh Master Key
APEXMIND_CORE_KEY="sk_apexmind_sovereign_core_mesh_key_2026"

# Additional Server Parameters
PAYPAL_MODE="sandbox" # "sandbox" or "live"
ENVIRONMENT="production"
PORT="3000"

