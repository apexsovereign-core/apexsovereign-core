# ==============================================================================
# ApexSovereign.ai - Enterprise Environment & Secret Vault Specification
# CISO Directive: Absolute Repository & Secret Privacy Lockdown
# CRITICAL: Sensitive production keys below MUST reside exclusively in encrypted
# server-side vaults (Render Environment / Vercel Environment Variables).
# Under NO circumstances should DATABASE_URL, PAYPAL_CLIENT_SECRET, APEXMIND_CORE_KEY,
# or RESEND_API_KEY be prefixed with VITE_ or NEXT_PUBLIC_ (Zero Client Bundle Leaks).
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- SERVER-SIDE ENCRYPTED SECRET VAULTS (RENDER / VERCEL) ---
# 1. Supabase PostgreSQL Async Connection String with RLS
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Master Administrative & Routing Key (X-API-Key header)
APP_SECRET_API_KEY="CHANGE_ME_USE_A_RANDOM_SERVER_SIDE_SECRET"

# 3. HMAC Secret for Signing Autonomous Compute Execution Leases
LEASE_HMAC_SECRET="CHANGE_ME_USE_A_RANDOM_HMAC_SECRET"

# 4. PayPal REST App Client ID
PAYPAL_CLIENT_ID="AZ_your_paypal_client_id_here"

# 5. PayPal REST App Secret Key (STRICTLY SERVER-SIDE)
PAYPAL_CLIENT_SECRET="EL_your_paypal_client_secret_here"

# 6. PayPal Webhook ID for Signature Verification
PAYPAL_WEBHOOK_ID="CHANGE_ME_PAYPAL_WEBHOOK_ID"

# 7. Resend API Key for Transactional Email Autopilot & Receipts
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="ApexSovereign Concierge <concierge@apexsovereign.ai>"
EMAIL_REPLY_TO="support@apexsovereign.ai"

# 8. SMS Authentication Gateway (Twilio or Enterprise SMS Provider)
TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550199"

# 9. ApexMind Sovereign Neural Mesh Master Key (STRICTLY SERVER-SIDE)
APEXMIND_CORE_KEY="CHANGE_ME_APEXMIND_CORE_KEY"

# --- OPTIONAL CLIENT CONFIGURATION (NON-SENSITIVE) ---
# Administrative Token for Development/Testing Clearance
VITE_ADMIN_ACCESS_TOKEN=""
VITE_ADMIN_ACCESS_T=""

# Additional Server Parameters
PAYPAL_MODE="sandbox" # "sandbox" or "live"
ENVIRONMENT="production"
PORT="3000"
