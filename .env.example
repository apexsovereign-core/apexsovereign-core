# =============================================================================
# APEXSOVEREIGN.AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Names only. No production secrets or credentials are hardcoded here.
# =============================================================================

# Service & Environment
ENV=
BUILD_ID=
LAUNCH_MODE=
PROVIDER_MODE=
LIVE_PAYMENTS_ACK=
RENDER_EXTERNAL_HOSTNAME=
PORT=
ALLOWED_ORIGINS=

# Frontend build-time API origin (FastAPI/Render). Leave empty only when the
# API is served from the same origin as the Vite build.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=

# Supabase Postgres (Direct Connection & Auth)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Cryptographic Ledger Signing (HMAC-SHA256)
LEDGER_HMAC_KID=
LEDGER_HMAC_KEYS_JSON=

# PayPal REST API v2
# Sandbox is the absolute default. Live mode aborts startup unless
# FOUNDER_PAYPAL_LIVE_OVERRIDE carries the founder confirmation token.
PAYPAL_ENV=sandbox
FOUNDER_PAYPAL_LIVE_OVERRIDE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Deposit Limits (cents: $1.00 = 100 CU = 100 cents)
DEPOSIT_MAX_TX_CENTS=
DEPOSIT_MAX_DAY_CENTS=
DEPOSIT_MAX_NEW_ACCOUNT_DAY_CENTS=

# Waitlist IP Privacy Salt
WAITLIST_IP_SALT=

# Upstash Redis rate limiting for public serverless routes
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_IP_SALT=

# Upstream Compute Supplier Adapter (When PROVIDER_MODE=supplier)
SUPPLIER_BASE_URL=
SUPPLIER_API_KEY=

# Observability
SENTRY_DSN=
