{
  "version": 2,
  "env": {
    "ENABLE_UV": "0"
  },
  "build": {
    "env": {
      "ENABLE_UV": "0"
    }
  },
  "builds": [
    { "src": "backend/settlement_api/main.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/health", "dest": "backend/settlement_api/main.py" },
    { "src": "/api/(.*)", "dest": "backend/settlement_api/main.py" },
    { "src": "/(.*)", "dest": "/backend/settlement_api/static/$1" }
  ]
}
